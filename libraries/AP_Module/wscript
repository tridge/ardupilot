    'sdk/src/serial.rs',
    'sdk/src/serialled.rs',
    'sdk/src/strtof.rs',
    'sdk/src/telemetry.rs',
    'sdk/src/values.rs',
]


def configure(cfg):
    cfg.env.AP_LIB_EXTRA_SOURCES['AP_Module'] = [
        'BindingImports_generated.cpp',
        'BindingMath_generated.cpp',
        'Bindings_generated.cpp',
    ]


def generate_bindings(task):
    command = list(task.env.PYTHON) + [
        task.generator.binding_generator.abspath(),
        '--output-dir', task.generator.output_dir.abspath(),
    ]
    return task.exec_command(command)


def build(bld):
    root = bld.srcnode.make_node('libraries/AP_Module')
    generator = root.make_node('generator')
    lua_generator = bld.srcnode.make_node('libraries/AP_Scripting/generator')
    output_dir = bld.bldnode.make_node('libraries/AP_Module')
    targets = [bld.bldnode.find_or_declare('libraries/AP_Module/' + name) for name in GENERATED]
    sources = generator.ant_glob('*.py *.json')
    sources += lua_generator.ant_glob('*.py templates/*.tmpl description/bindings.desc')
    sources += [bld.srcnode.make_node('modules/mavlink/message_definitions/v1.0/common.xml')]
    bld(
        name='rust_bindings',
        source=sources,
        target=targets,
        rule=generate_bindings,
        cls_str=lambda task: 'AP_Module bindings',
        binding_generator=generator.make_node('generate.py'),
        output_dir=output_dir,
        vars=['PYTHON'],
        group='dynamic_sources',
    )
