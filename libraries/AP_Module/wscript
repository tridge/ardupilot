GENERATED = [
    'BindingConfig.h',
    'BindingIds.h',
    'BindingImports_generated.cpp',
    'BindingLog_generated.h',
    'BindingMath_generated.cpp',
    'Bindings_generated.cpp',
    'HostApi.h',
    'generator/bindings_contract.json',
    'generator/coverage.json',
    'generator/imports.json',
    'sdk/abi.json',
    'sdk/src/airspeed.rs',
    'sdk/src/analog_pwm.rs',
    'sdk/src/api.rs',
    'sdk/src/applet.rs',
    'sdk/src/arming.rs',
    'sdk/src/battery.rs',
    'sdk/src/bindings.rs',
    'sdk/src/borrowed.rs',
    'sdk/src/camera.rs',
    'sdk/src/can.rs',
    'sdk/src/command_int.rs',
    'sdk/src/crsf.rs',
    'sdk/src/custom_mode.rs',
    'sdk/src/dronecan.rs',
    'sdk/src/efi.rs',
    'sdk/src/enums.rs',
    'sdk/src/example_constants.rs',
    'sdk/src/examples.rs',
    'sdk/src/file.rs',
    'sdk/src/filesystem.rs',
    'sdk/src/format.rs',
    'sdk/src/i2c.rs',
    'sdk/src/imports.rs',
    'sdk/src/libm.rs',
    'sdk/src/log.rs',
    'sdk/src/math.rs',
    'sdk/src/mavlink.rs',
    'sdk/src/motor_config.rs',
    'sdk/src/network.rs',
